[Unit]
Description=kitchCU one-shot full seed (dev baseline + bulk/feature-volume + weekly cohort)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/ckac/infra/gcp-vm/bulk-seed.sh
# 30 kitchens × 6-month history on e2-small; script waits on /health/ready internally.
TimeoutStartSec=21600
