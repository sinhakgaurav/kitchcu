[Unit]
Description=kitchCU one-shot bulk demo seed (owners, kitchens, menus, orders, extras)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/ckac/infra/gcp-vm/bulk-seed.sh
# 30 kitchens + extras on e2-small; script waits on /health/ready internally.
TimeoutStartSec=7200
