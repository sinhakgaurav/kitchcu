[Unit]
Description=kitchCU Saturday weekly QA cohort + 7-day order fill
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/ckac/infra/gcp-vm/weekly-seed.sh
# ~500 API calls (5 menus, 50 orders through the lifecycle, marketing, growth) and
# the e2-small VM is slow under load; seeding waits on readiness internally anyway.
TimeoutStartSec=3600
