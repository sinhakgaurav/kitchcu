[Unit]
Description=Run the kitchCU weekly QA cohort seed every Monday

[Timer]
# Saturday 03:30 IST == Friday 22:00 UTC (VM clock is UTC) — fill the trailing week.
OnCalendar=Fri *-*-* 22:00:00 UTC
# Catch up if the VM was stopped at the scheduled time.
Persistent=true
Unit=kitchcu-weekly-seed.service

[Install]
WantedBy=timers.target
